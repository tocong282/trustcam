# Backend only. Export variables before starting uvicorn; .env is not auto-loaded.
# Base includes /v1 if required. Backend appends /chat/completions.
# Use approved HTTPS provider supporting vision + JSON output.
VLM_BASE_URL=https://your-approved-provider.example/v1
VLM_MODEL=analysis
VLM_API_KEY=
# Optional private storage path:
# TRUSTCAM_DATA_DIR=/absolute/private/path
# Mobile public API URL (never place provider secret here):
# EXPO_PUBLIC_API_URL=http://your-computer-lan-ip:8000
