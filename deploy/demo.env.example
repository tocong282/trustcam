# Example only. Copy outside repository; replace password before start.
# systemd EnvironmentFile syntax, not shell; no export or $(...) expansion.
TRUSTCAM_DATA_DIR=/var/lib/trustcam
TRUSTCAM_DASHBOARD_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# Deliberately omit TRUSTCAM_DASHBOARD_ALLOW_HTTP: Secure cookies stay enabled.
# Optional VLM: leave ALL THREE absent for checklist-only demo.
# VLM_BASE_URL=https://APPROVED_PROVIDER.example.invalid/v1
# VLM_MODEL=REPLACE_WITH_APPROVED_MODEL
# VLM_API_KEY=REPLACE_WITH_PROVIDER_SECRET
