[Unit]
Description=TRUSTCAM private demo API (not public production)
After=network.target

[Service]
Type=simple
User=trustcam
Group=trustcam
WorkingDirectory=/opt/trustcam
EnvironmentFile=/etc/trustcam/demo.env
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=trustcam
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/trustcam/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --limit-concurrency 8 --timeout-keep-alive 5 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trustcam

[Install]
WantedBy=multi-user.target
